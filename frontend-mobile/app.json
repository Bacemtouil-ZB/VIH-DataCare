{
  "expo": {
    "name": "Zaytouna",
    "slug": "frontend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zb9.vihdatacare",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a6b4a"
      },
      "permissions": [
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a6b4a",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0d3d2a",
            "image": "./assets/icon.png"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1a6b4a"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "1a501d53-b5d2-4f43-bfdc-7a01b2cc3bca"
      }
    },
    "owner": "zb9"
  }
}